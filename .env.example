# =============================================================================
# MULTI-AGENT TELEGRAM COUNCIL - CONFIGURATION TEMPLATE
# =============================================================================

# -----------------------------------------------------------------------------
# 1. LLM API KEYS (Unified OpenRouter OR Native Providers)
# -----------------------------------------------------------------------------
# OPTION A (RECOMMENDED): Unified OpenRouter Key (powers all 5-15 models with 1 key)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OPTION B: Native Provider Keys (used if OpenRouter key is empty)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
MISTRAL_API_KEY=

# -----------------------------------------------------------------------------
# 2. TELEGRAM GROUP CHAT & ADMIN WHITELIST
# -----------------------------------------------------------------------------
# Telegram Group Chat ID where debates & votes occur (e.g. -1004310499587 for Chatters)
GROUP_CHAT_ID=-1004310499587

# Comma-separated list of Telegram User IDs allowed to trigger /deb, /vot, /exe, /dve
# To find your User ID, message @userinfobot on Telegram.
# If left empty, ANY member in the group chat can trigger council commands.
ADMIN_USER_IDS=2068383520

# Index of the bot that listens for updates (0 = Bot 1 Claude)
LISTENER_BOT_INDEX=0

# -----------------------------------------------------------------------------
# 3. INITIAL 5 TELEGRAM BOT TOKENS
# -----------------------------------------------------------------------------
# Bot 1: Claude (Claudetalks / @claudetalkbbot)
BOT_TOKEN_CLAUDE=8828456879:AAHqJUXEuCK4W--r4t3brAR30mn7sThLMLY

# Bot 2: GPT (GPTtalks / @gpttalkbbot)
BOT_TOKEN_GPT=8630079807:AAEhjG1JY8RzayPeI3hLfc5Dixmvh7eJcUs

# Bot 3: DeepSeek (DeepSeektalks / @deepseektalkbbot)
BOT_TOKEN_DEEPSEEK=8882002776:AAGdh55_7Ct6RJ3PGDZk_wEAsTnZIrOz0fY

# Bot 4: Gemini (Geminitalks / @geminitalkbbot)
BOT_TOKEN_GEMINI=8934071377:AAEXDzWKMLjpDkPlxztbmwzPKqRge8vSegk

# Bot 5: Grok (Groktalks / @groktalkbbot)
BOT_TOKEN_GROK=8607678038:AAHxLLtGoL6gEgnJoN35toGkKPbWCYC8VHI

# -----------------------------------------------------------------------------
# 4. EXPANDABLE BOT SLOTS (Bots 6 through 15)
# -----------------------------------------------------------------------------
# Simply paste bot tokens from @BotFather to activate additional agents:
BOT_TOKEN_MISTRAL=
BOT_TOKEN_LLAMA=
BOT_TOKEN_QWEN=
BOT_TOKEN_COHERE=
BOT_TOKEN_PERPLEXITY=
BOT_TOKEN_DBRX=
BOT_TOKEN_HAIKU=
BOT_TOKEN_MINIGPT=
BOT_TOKEN_GROKMINI=
BOT_TOKEN_MIXTRAL=

# -----------------------------------------------------------------------------
# 5. COUNCIL OPERATIONAL SETTINGS
# -----------------------------------------------------------------------------
# Number of debate rounds per agent in /deb mode (default: 2)
DEBATE_MAX_ROUNDS=2

# Consensus threshold required to pass a vote (0.50 = 50% majority, 0.75 = 75%)
CONSENSUS_THRESHOLD=0.50

# Default mood: analytical, skeptical, aggressive, conservative, ruthless, contrarian
DEFAULT_MOOD=analytical

# Typing delay simulation (in seconds) between bot responses
BOT_TYPING_DELAY_SECONDS=1.5

# -----------------------------------------------------------------------------
# 6. EXTERNAL EXECUTION (Market Sniffer Bot Integration)
# -----------------------------------------------------------------------------
# Dispatch mode: "webhook", "telegram", "local_ipc", or "all"
MSNIFFER_DISPATCH_MODE=webhook

# HTTP Webhook URL where Market Sniffer listens for trade orders
MSNIFFER_WEBHOOK_URL=http://127.0.0.1:8088/trade

# Shared secret key configured in Market Sniffer (ORCHESTRATOR_SECRET)
MSNIFFER_SECRET=

# Telegram chat/channel or bot username where trade signals are sent if using "telegram" dispatch
MSNIFFER_CHAT_ID=@Msnifferbot

# Default buy amount in SOL when consensus passes
DEFAULT_TRADE_AMOUNT_SOL=0.25

# Default slippage in basis points (300 bps = 3.0%)
DEFAULT_SLIPPAGE_BPS=300
